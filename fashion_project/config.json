{
  "project_title": "LLM-Assisted Personalized Fashion Recommendation System",
  "version": "1.0.0",
  "random_seed": 42,
  "environment": {
    "is_colab": false,
    "python_version": "3.14.0",
    "pytorch_version": "2.15.0+cpu",
    "cuda_available": false,
    "target_platform": "Streamlit Web Application & Python Services"
  },
  "dataset": {
    "source_url": "https://www.kaggle.com/datasets/paramaggarwal/fashion-product-images-small",
    "styles_csv": "data/raw/styles.csv",
    "images_dir": "data/raw/images",
    "archive_preserved": "data/raw/fashion-product-images-small.zip"
  },
  "paths": {
    "catalog_csv": "artifacts/catalog.csv",
    "catalog_ids_json": "artifacts/catalog_ids.json",
    "catalog_images_dir": "data/catalog_images",
    "image_cdn_url": "",
    "data_audit_json": "artifacts/data_audit.json",
    "catalog_manifest_json": "artifacts/catalog_manifest.json",
    "product_descriptions_csv": "artifacts/product_descriptions.csv",
    "embeddings_npy": "artifacts/embeddings.npy",
    "embedding_manifest_json": "artifacts/embedding_manifest.json",
    "clip_embeddings_npy": "artifacts/clip_embeddings.npy",
    "clip_manifest_json": "artifacts/clip_manifest.json",
    "profiles_sqlite": "backups/profiles.sqlite",
    "backups_dir": "backups",
    "logs_dir": "logs",
    "docs_dir": "docs",
    "services_dir": "services",
    "tests_dir": "tests"
  },
  "embedding_model": {
    "name": "sentence-transformers/all-MiniLM-L6-v2",
    "dimension": 384,
    "normalized": true,
    "batch_size": 64
  },
  "clip_model": {
    "name": "sentence-transformers/clip-ViT-B-32",
    "dimension": 512,
    "normalized": true,
    "batch_size": 64,
    "device": "cpu"
  },
  "language_model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "tokenizer_vocab_size": 151643,
    "chat_template": "official",
    "decoding": "deterministic",
    "max_new_tokens": 256,
    "retry_limit": 1
  },
  "personalization": {
    "ranking_formula": "score = Wt * cosine(q_text, v_text) + Wv * cosine(q_img, v_img) + Wp * cosine(u, v_text)",
    "baseline_weights": {
      "query_weight": 0.8,
      "profile_weight": 0.2
    },
    "hybrid_weights": {
      "text_weight": 0.5,
      "visual_weight": 0.3,
      "preference_weight": 0.2
    },
    "image_only_weights": {
      "visual_weight": 0.8,
      "preference_weight": 0.2
    },
    "text_only_weights": {
      "text_weight": 0.8,
      "preference_weight": 0.2
    },
    "query_weight": 0.8,
    "profile_weight": 0.2,
    "top_k": 5,
    "supported_constraints": [
      "articleType",
      "baseColour",
      "usage",
      "masterCategory",
      "subCategory",
      "gender",
      "season",
      "exclude_colors"
    ]
  }
}
