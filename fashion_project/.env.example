# Application Configuration Template
# Copy to .env and customize as needed. Never commit .env to source control.

# Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Product Image Delivery Configuration
# Leave blank to use bundled catalog images in data/catalog_images/
# Or provide a public CDN base URL (e.g., https://my-cdn.com/catalog_images)
IMAGE_CDN_URL=

# Model & Cache Paths
HF_HOME=~/.cache/huggingface
TORCH_HOME=~/.cache/torch

# Optional External Language Model Provider
# When unset, the system automatically runs deterministic grounded rule-based extraction
# OPENAI_API_KEY=your_openai_api_key_here
# HF_TOKEN=your_huggingface_token_here

# Hardware Overrides (cpu or cuda)
DEVICE_OVERRIDE=cpu
CLIP_BATCH_SIZE=64
